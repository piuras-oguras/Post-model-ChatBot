# --- guard model (required) ---
# gpt-oss-safeguard via a local Ollama instance Pull it first:  ollama pull gpt-oss-safeguard:20b
# Swap base_url/name to any other OpenAI-compatible classifier without a code change.
# With docker compose, remove this line or use
# http://host.docker.internal:11434/v1 — inside the container "localhost" is the container itself.
POSTMODEL__GUARD_MODEL__BASE_URL=http://localhost:11434/v1
POSTMODEL__GUARD_MODEL__API_KEY=not-needed
POSTMODEL__GUARD_MODEL__NAME=gpt-oss-safeguard:20b
POSTMODEL__GUARD_MODEL__REQUEST_TIMEOUT_SECONDS=180.0

# --- service auth (optional; empty = disabled, service trusts its network) ---
POSTMODEL__API_TOKEN=

# --- docker compose ---
# Host port the container is published on; the service inside always listens on 8011.
# Running locally, pass --host/--port to uvicorn instead.
POSTMODEL__PORT=8011