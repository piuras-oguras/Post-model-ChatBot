# --- guard model (required) ---
# gpt-oss-safeguard via a local Ollama instance — same default as the
# ChatBot project. Pull it first:  ollama pull gpt-oss-safeguard:20b
# Swap base_url/name to any other OpenAI-compatible classifier without a
# code change.
POSTMODEL__GUARD_MODEL__BASE_URL=http://localhost:11434/v1
POSTMODEL__GUARD_MODEL__API_KEY=not-needed
POSTMODEL__GUARD_MODEL__NAME=gpt-oss-safeguard:20b
POSTMODEL__GUARD_MODEL__REQUEST_TIMEOUT_SECONDS=180.0

# --- output-guard behavior ---
# Fallback when a /v1/check request omits requires_grounding. Default false
# (matches ChatBot): grounding stays off until the caller supplies
# retrieved_context; relevance/safety/leakage checks run regardless.
POSTMODEL__OUTPUT_GUARD__REQUIRES_GROUNDING=false

# --- service auth (optional; empty = disabled, service trusts its network) ---
POSTMODEL__API_TOKEN=

# --- network binding ---
POSTMODEL__HOST=0.0.0.0
POSTMODEL__PORT=8011